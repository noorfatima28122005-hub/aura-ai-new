# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID.
# When provided, enables production Google Identity Services authentication with verified domains.
GOOGLE_CLIENT_ID=

# FIREBASE CONFIGURATION (Vite Frontend):
# If not specified in runtime environment, defaults to firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0655069095.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0655069095"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0655069095.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="429833408376"
VITE_FIREBASE_APP_ID="1:429833408376:web:000a910bd3b8d2ea6e028d"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-auraai-fbba9aaa-6efa-4616-8282-cba9b9b13e7b"

